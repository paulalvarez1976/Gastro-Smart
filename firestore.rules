rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGastroSmartRead() {
      return resource == null || resource.data.appId == 'gastro_smart';
    }

    function isGastroSmartCreate() {
      return request.resource.data.appId == 'gastro_smart';
    }

    function isGastroSmartUpdate() {
      return (resource == null || resource.data.appId == 'gastro_smart') &&
             request.resource.data.appId == 'gastro_smart';
    }

    function isGastroSmartDelete() {
      return resource == null || resource.data.appId == 'gastro_smart';
    }

    match /users/{userId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /businesses/{businessId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /restaurants/{restaurantId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /employees/{employeeId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /tables/{tableId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /orders/{orderId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /menuItems/{menuItemId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /clients/{clientId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /shifts/{shiftId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /cashRegisterCloses/{closeId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /expenses/{expenseId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /loginAttempts/{attemptId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }

    match /securityAlerts/{alertId} {
      allow read: if isGastroSmartRead();
      allow create: if isGastroSmartCreate();
      allow update: if isGastroSmartUpdate();
      allow delete: if isGastroSmartDelete();
    }
  }
}
