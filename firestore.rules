rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGastroSmart(data) {
      return data != null && ('appId' in data) && data.appId == 'gastro_smart';
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserBusinessId() {
      return userExists() && ('businessId' in getUserData()) ? getUserData().businessId : null;
    }

    function isBusinessOwner(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId)) &&
             ('ownerUid' in get(/databases/$(database)/documents/businesses/$(businessId)).data) &&
             get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    function isUserInBusiness(businessId) {
      return isAuthenticated() && businessId != null && (
        getUserBusinessId() == businessId ||
        isBusinessOwner(businessId)
      );
    }

    function matchesTenant(data) {
      return data != null && (
        ('businessId' in data && data.businessId != null && isUserInBusiness(data.businessId)) ||
        ('restaurantId' in data && data.restaurantId != null)
      );
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 2. BUSINESSES COLLECTION
    // ==========================================
    match /businesses/{businessId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 3. RESTAURANTS COLLECTION (SUCURSALES)
    // ==========================================
    match /restaurants/{restaurantId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 4. EMPLOYEES COLLECTION
    // ==========================================
    match /employees/{employeeId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 5. TABLES COLLECTION
    // ==========================================
    match /tables/{tableId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 6. ORDERS COLLECTION
    // ==========================================
    match /orders/{orderId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 7. MENU ITEMS COLLECTION
    // ==========================================
    match /menuItems/{menuItemId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 8. CLIENTS COLLECTION
    // ==========================================
    match /clients/{clientId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 9. SHIFTS COLLECTION (TURNOS)
    // ==========================================
    match /shifts/{shiftId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 10. CASH REGISTER CLOSES (CIERRES DE CAJA)
    // ==========================================
    match /cashRegisterCloses/{closeId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 11. EXPENSES COLLECTION (GASTOS)
    // ==========================================
    match /expenses/{expenseId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 12. SUPPLIERS COLLECTION (PROVEEDORES)
    // ==========================================
    match /suppliers/{supplierId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 13. LOGIN ATTEMPTS (AUDITORÍA DE ACCESOS)
    // ==========================================
    match /loginAttempts/{attemptId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 14. SECURITY ALERTS (ALERTAS DE SEGURIDAD)
    // ==========================================
    match /securityAlerts/{alertId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 15. DAILY STATS (ESTADÍSTICAS DIARIAS)
    // ==========================================
    match /dailyStats/{statId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // 16. MENU AUDIT LOGS (REGISTROS DE AUDITORÍA DE MENÚ Y STOCK)
    // ==========================================
    match /menuAuditLogs/{logId} {
      allow read: if isGastroSmart(resource.data) || isAuthenticated();
      allow create: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow update: if isGastroSmart(request.resource.data) || isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
