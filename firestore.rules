rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isGastroSmartDoc() {
      return (resource == null || resource.data.appId == 'gastro_smart') &&
             (request.resource == null || request.resource.data.appId == 'gastro_smart');
    }

    // Reglas para la colección users de Gastro Smart
    match /users/{userId} {
      allow get: if resource == null || resource.data.appId == 'gastro_smart';
      allow list: if resource.data.appId == 'gastro_smart';
      allow create: if request.resource.data.appId == 'gastro_smart';
      allow update: if (resource == null || resource.data.appId == 'gastro_smart') && 
                       request.resource.data.appId == 'gastro_smart';
      allow delete: if resource.data.appId == 'gastro_smart';
    }

    // Reglas para las colecciones operativas y multi-tenant de Gastro Smart
    match /businesses/{businessId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /restaurants/{restaurantId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /employees/{employeeId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /tables/{tableId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /orders/{orderId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /menuItems/{menuItemId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /clients/{clientId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /shifts/{shiftId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /cashRegisterCloses/{closeId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /expenses/{expenseId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /loginAttempts/{attemptId} {
      allow read, write: if isGastroSmartDoc();
    }

    match /securityAlerts/{alertId} {
      allow read, write: if isGastroSmartDoc();
    }

    // Bloqueo estricto por defecto para documentos ajenos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
