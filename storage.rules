rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageBelow5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Carpeta de fotos de menú de platos por restaurante
    match /restaurants/{restaurantId}/menu/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImageBelow5MB();
      allow delete: if isAuthenticated();
    }

    // Carpeta de comprobantes de gastos por restaurante
    match /restaurants/{restaurantId}/receipts/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isImageBelow5MB();
      allow delete: if isAuthenticated();
    }
  }
}

