rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Carpeta de menús y recursos por restaurante
    match /restaurants/{restaurantId}/{allPaths=**} {
      // Lectura pública/todos los roles para visualizar fotos en POS y Cocina
      allow read: if true;
      
      // Subida, modificación y eliminación permitida para administradores del restaurante
      allow write: if request.auth != null;
    }
  }
}
